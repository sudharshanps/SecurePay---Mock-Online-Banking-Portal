# ========================================================
# SecurePay — Mock Online Banking Portal Configuration
# TrustBank Digital (Simulation & Educational Use Only)
# ========================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Client URL (for CORS & Cookie Origin)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local Replica Set or Atlas)
# If left blank, server defaults to mongodb://localhost:27017/securepay_mock_banking
MONGODB_URI=mongodb://localhost:27017/securepay_mock_banking

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_super_secret_high_entropy_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# CSRF Secret (Double Submit Cookie HMAC Secret)
CSRF_SECRET=replace_with_a_secure_csrf_secret_random_32_characters_here

# Cookie Security (set to 'true' in HTTPS production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Demo Banking Limits (Stored in Integer Paise: 1 INR = 100 Paise)
# Default Min: ₹1.00 = 100 Paise
MIN_TRANSFER_PAISE=100
# Default Max: ₹2,00,000.00 = 20,000,000 Paise
MAX_TRANSFER_PAISE=20000000
# Initial Demo Balance for New Customers: ₹50,000.00 = 5,000,000 Paise
INITIAL_DEMO_BALANCE_PAISE=5000000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MS=900000
